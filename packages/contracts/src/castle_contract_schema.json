          "type": "string"
        },
        "trashId": {
          "type": "string"
        },
        "sourceGeneration": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "publicationPending": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "noteId",
        "sourceFile",
        "generatedAt",
        "trashId"
      ]
