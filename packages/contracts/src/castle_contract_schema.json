        },
        "expectedRevision": {
          "type": "string"
        }
      },
      "required": [
        "noteId",
        "sourceFile",
        "markdown",
        "expectedRevision"
      ]
    },
    "CreateSourceInput": {
      "type": "object",
      "properties": {
        "noteId": {
