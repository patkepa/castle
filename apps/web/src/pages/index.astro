---
import CastleLayout from "../layouts/CastleLayout.astro";
import { getSitePresentation, sectionLabel } from "../lib/site";
import { loadCatalog, withBase } from "../lib/snapshot";

const catalog = await loadCatalog();
const base = import.meta.env.BASE_URL;
const site = getSitePresentation();
const technical = site.variant === "technical";
const visibleSections = technical
  ? catalog.sections.filter((section) => section.count > 0)
  : catalog.sections;
---

<CastleLayout catalog={catalog} title={technical ? `${site.homeTitle} · ${site.name}` : "Castle"}>
  <div class:list={["library-home", { "docs-home": technical }]}>
    <header>
      <h1>{site.homeTitle}</h1>
      <p>
        {technical
          ? site.homeDescription
          : `${catalog.notes.length} documents, published as a read-only Castle website.`}
      </p>
    </header>
    <div class="section-list">
      {
        visibleSections.map((section) => {
          const notes = catalog.notes.filter((note) => note.section === section.id);
          return (
            <section data-search-group>
              <header class="section-heading">
                <h2>{sectionLabel(site.variant, section.id, section.label)}</h2>
                {technical && <span>{notes.length} {notes.length === 1 ? "document" : "documents"}</span>}
              </header>
              <ol>
                {notes.map((note) => (
                  <li data-search-item data-search-value={`${note.title} ${note.excerpt}`}>
                    <a href={withBase(note.route, base)}>
                      <strong>{note.title}</strong>
                      <span>{note.excerpt}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          );
        })
      }
    </div>
  </div>
</CastleLayout>
