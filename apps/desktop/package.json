{
  "name": "@castle/desktop",
  "productName": "Castle",
  "version": "0.1.0",
  "description": "Castle's local-first Markdown desktop application.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "generate:icons": "node scripts/generate-blueprint-icon-loader.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --preserve-symlinks --import ./scripts/register-desktop-tsx.mjs --test test/*.test.js",
    "typecheck": "tsc --noEmit && tsc -p config/tsconfig.electron.json",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "@blueprintjs/icons": "^6.2.0",
    "@castle/content": "0.1.0",
    "@castle/contracts": "0.1.0",
    "@patkepa/kantzen-ui": "0.1.0",
    "@videojs/react": "10.0.0-beta.28",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@xmldom/xmldom": "^0.9.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "43.2.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "vite": "^7.0.0"
  },
  "config": {
    "forge": "./config/forge.config.ts"
  }
}
