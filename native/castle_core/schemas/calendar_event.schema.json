{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "castle://schemas/calendar_event",
  "title": "Castle calendar-event record",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "schema_version", "id", "date", "start", "kind"],
  "properties": {
    "type": { "const": "calendar_event" },
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "start": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" },
    "end": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" },
    "end_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "recurrence": { "enum": ["weekly"] },
    "repeat_until": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "timezone": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["work", "social"] },
    "description": { "type": "string", "minLength": 1 },
    "people": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/wikiLink" } },
    "project": { "$ref": "#/$defs/wikiLink" },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "wikiLink": { "type": "string", "pattern": "^\\[\\[[^\\]|]+(?:\\|[^\\]]+)?\\]\\]$" }
  }
}
